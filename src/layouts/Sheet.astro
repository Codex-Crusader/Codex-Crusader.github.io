---
// A single sheet of the atlas: the frame, the parchment, the head.
//
// index.astro is the map and carries its own head, because it is the one page
// with a share card, a Person graph and eleven screens of folio. The register
// and the charters are ordinary documents by comparison, and three copies of
// the same twenty-line head would drift the first time one of them was edited.
//
// Everything absolute is derived, never typed: `home` from Astro.site and the
// configured base, exactly as index.astro does it, so a project-page deploy
// cannot ship a canonical naming a site it is not.
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  // Path relative to the site root, with no leading slash: 'projects/' or
  // 'projects/bruhswer/'. The canonical and og:url are built from it.
  path: string;
  // Optional structured data. Passed in already shaped, serialised here.
  schema?: unknown;
}

const { title, description, path, schema } = Astro.props;

const base = import.meta.env.BASE_URL;
const home = new URL(base, Astro.site).href;
const here = new URL(path, home).href;
const cover = new URL('og-cover.png', home).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={here} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="theme-color" content="#C7B991" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="The realm of Orvia" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={here} />
    <meta property="og:image" content={cover} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A hand-drawn map of the realm of Orvia, the portfolio's five sections shown as provinces." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cover} />
    <meta name="twitter:image:alt" content="A hand-drawn map of the realm of Orvia, the portfolio's five sections shown as provinces." />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div
      class="frame"
      aria-hidden="true"
      style="position: fixed; inset: 13px; pointer-events: none; z-index: 60; border: 2px solid rgba(74,59,34,0.5); box-shadow: inset 0 0 0 5px rgba(74,59,34,0), inset 0 0 0 6px rgba(74,59,34,0.24);"
    >
      <span style="position: absolute; top: -7px; left: -7px; width: 11px; height: 11px; background: #6B5836; transform: rotate(45deg);"></span>
      <span style="position: absolute; top: -7px; right: -7px; width: 11px; height: 11px; background: #6B5836; transform: rotate(45deg);"></span>
      <span style="position: absolute; bottom: -7px; left: -7px; width: 11px; height: 11px; background: #6B5836; transform: rotate(45deg);"></span>
      <span style="position: absolute; bottom: -7px; right: -7px; width: 11px; height: 11px; background: #6B5836; transform: rotate(45deg);"></span>
    </div>

    <div class="page" style="max-width: 1040px; margin: 0 auto; padding: 0 44px;">
      <slot />
    </div>
  </body>
</html>
