---
// One spread of the lorebook: heading, folio number, drop-capped intro,
// a body (passed in as a slot) and the margin ledger on the right.
//
// The parchment texture for each spread is unique and comes from
// src/data/section-textures.json, keyed by the section id.
import textures from '../data/section-textures.json';

interface Props {
  id: string;
  heading: string;
  folio: string;
  intro: string;
  ledger: [string, string][];
  ledgerNote: string;
  // Optional. A short in-voice line under the heading, and a marginal
  // annotation under the ledger note. Absent fields render nothing.
  epigraph?: string;
  marginNote?: string;
  // Puts the ledger on the left for this spread. Alternated down the page so
  // five sections stop reading as five copies of one section.
  flip?: boolean;
  // Off for a spread on a page that may not scroll. The reveal is a
  // scroll-driven CSS timeline, and a timeline with no scrollport never runs,
  // which would leave the whole spread committed to opacity 0. Same reason the
  // 404 and /resume opt out entirely.
  reveal?: boolean;
  // The road out at the foot of the spread. On the front page every spread
  // returns to the map above it; a spread that is its own page returns
  // somewhere else, or renders no link at all and puts its own roads in the
  // slot. Null removes it.
  returnHref?: string | null;
  returnLabel?: string;
  // Which parchment to print on. Defaults to the section id, which is how the
  // five folios have always keyed it. A charter is a page of the Afon Empire
  // wherever it happens to be filed, so it asks for that province's sheet by
  // name rather than by borrowing its id and losing its own anchor.
  texture?: string;
  // 2 on the front page, where the h1 is the name in the masthead and five
  // spreads are five sections of one document. 1 on a page that is only this
  // spread, because a page whose subject has no h1 has not said what it is
  // about in the one element that is read as the answer.
  level?: 1 | 2;
  // The mark set large in the corner. Defaults to the folio with its "FOL."
  // stripped, which is the whole label for a folio and the wrong half of one
  // for anything else: "CHARTER IV" has nothing to strip, so the mark and the
  // line under it printed the same words twice.
  numeral?: string;
  // The province name in plain words, set small under it.
  //
  // The five headings are place names, and a place name is the one thing on a
  // spread that does not say what the spread is about: "Phoededia" is a
  // beautiful label and an unreadable one, to a stranger and to a crawler
  // alike. This is the same fix the masthead already makes, where the name is
  // followed by the trade in six plain words. It is set as a filing annotation
  // rather than a subheading, because the province keeps its name: the line
  // under it is a translation, not a replacement.
  subtitle?: string;
}

const {
  id,
  heading,
  folio,
  intro,
  ledger,
  ledgerNote,
  epigraph,
  marginNote,
  flip,
  reveal = true,
  returnHref = '#map',
  returnLabel = '↑ return to map',
  texture,
  level = 2,
  numeral: numeralProp,
  subtitle,
} = Astro.props;
const t = textures[texture ?? id];

// "FOL. III" -> "III". The numeral is set large as a mark on the page; the word
// stays with it in the small line so the folio still reads as a folio.
const numeral = numeralProp ?? folio.replace(/^FOL\.\s*/i, '');

// The heading tag, chosen rather than hard-coded. Capitalised so Astro renders
// the variable as a component tag instead of the literal element "h".
const H = `h${level}`;

// The design sets the first letter of the intro as a drop cap.
const dropCap = intro.slice(0, 1);
const rest = intro.slice(1);
---

<section
  id={id}
  class:list={['spread', { reveal, flip }]}
  style={`background: ${t.background}; border: 2px solid #4A3B22; border-radius: 5px; padding: 52px 58px 44px; box-shadow: ${t.shadow}; margin-bottom: ${t.mb}px;`}
>
  <div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; border-bottom: 1px solid #B9A87E; padding-bottom: 14px; margin-bottom: 26px;">
    <div class="spread-title">
      <H style="margin: 0; font-family: 'Cormorant Garamond', serif; font-weight: 600; font-size: clamp(30px, 5.2vw, 54px); line-height: 0.95; letter-spacing: 4px; font-variant: small-caps; color: #3A2E19;">{heading}</H>
      {subtitle && <p class="spread-subtitle">{subtitle}</p>}
    </div>
    <div style="text-align: right; flex-shrink: 0;">
      {numeral && <div class="folio-mark" aria-hidden="true">{numeral}</div>}
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #8A7752; letter-spacing: 1.4px; margin-top: 6px;">{folio}</div>
    </div>
  </div>

  {epigraph && (
    <p style="margin: 0 0 22px; font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: clamp(16px, 1.7vw, 19px); line-height: 1.45; color: #6B5836;">{epigraph}</p>
  )}

  <div class="prose-grid" style="display: grid; grid-template-columns: 1fr 210px; gap: 40px; align-items: start;">
    <div style="max-width: 68ch;">
      <p style="margin: 0 0 22px; font-size: 16.5px; line-height: 1.72;"><span class="drop-cap" style="float: left; font-family: 'Cormorant Garamond', serif; font-size: 4.4em; line-height: 0.72; font-weight: 600; color: #8C3B22; margin: 6px 12px -6px 0;">{dropCap}</span>{rest}</p>
      <slot />
    </div>

    <aside class="margin-col" style="border-left: 1px solid #B9A87E; padding-left: 30px;">
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #8A7752; letter-spacing: 2px; margin-bottom: 14px;">LEDGER</div>
      <dl style="margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 10px 14px; font-family: 'JetBrains Mono', monospace; font-size: 12px;">
        {ledger.map(([term, value]) => (
          <>
            <dt style="color: #8A7752;">{term}</dt>
            <dd style="margin: 0; color: #6B5836; text-align: right;">{value}</dd>
          </>
        ))}
      </dl>
      <p style="margin: 18px 0 0; font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 15px; line-height: 1.5; color: #6B5836;">{ledgerNote}</p>
      {marginNote && (
        <p style="margin: 14px 0 0; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: #8A7752; letter-spacing: 0.5px; line-height: 1.5;">※ {marginNote}</p>
      )}
    </aside>
  </div>

  {returnHref && (
    <div class="return-link" style="margin-top: 34px; border-top: 1px solid #B9A87E; padding-top: 16px;"><a href={returnHref} style="font-family: 'JetBrains Mono', monospace; font-size: 12px;">{returnLabel}</a></div>
  )}
</section>
