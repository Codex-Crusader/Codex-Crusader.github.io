---
import '../styles/global.css';
import OrviaMap from '../components/OrviaMap.astro';
import Lorebook from '../components/Lorebook.astro';
import Holding from '../components/Holding.astro';
import { assignSymbols } from '../data/holdings.js';
import { surveyRealm } from '../data/settlements.js';
import Post from '../components/Post.astro';
import { layTimeline, placeOf } from '../data/tenure.js';
import profile from '../data/profile.js';
import resume from '../data/resume.js';
import github from '../data/github.json';
import photos from '../data/photos.json';
import charters from '../data/charters.js';
import { typeFor, applicationProps } from '../data/software.js';

// The workflow passes github.run_number in. Locally it falls back to 0.
const runNumber = import.meta.env.PUBLIC_RUN_NUMBER ?? '0';
const inscription = profile.site.mapInscription.replace('{run}', runNumber);

const mono = "font-family: 'JetBrains Mono', monospace;";
const serif = "font-family: 'Cormorant Garamond', serif;";

function ago(iso) {
  if (!iso) return 'unknown';
  const days = Math.floor((Date.now() - new Date(iso)) / 86400000);
  if (days <= 0) return 'today';
  if (days === 1) return 'yesterday';
  if (days < 30) return `${days} days ago`;
  const months = Math.round(days / 30);
  if (months < 12) return months === 1 ? '1 month ago' : `${months} months ago`;
  const years = Math.round(days / 365);
  return years === 1 ? '1 year ago' : `${years} years ago`;
}

const repos = github.repos ?? [];
// Dealt once for the whole Afon Empire rather than per holding, so every mark
// in the legend is used before any of them is used twice.
const holdingSymbols = assignSymbols(repos.map((r) => r.name));

// A role's map label is the organisation, not the job title: "Technology &
// Operations Intern, Sanjay Electrical Enterprises" is a sentence, and a
// settlement needs a name. Trailing parentheticals go too, since "Kanyathon"
// is the place and "(Mumbai Division)" is a footnote about it.
const orgOf = (title) => {
  const [role, ...rest] = title.split(',');
  const org = rest.join(',').replace(/\([^)]*\)/g, '').trim();
  // "Self-employed" is not a place, and two of these roles carry it, which put
  // the same name on the map twice. Fall back to what the work was.
  if (!org || /^self-?employed$/i.test(org)) {
    return role.trim().split(/\s+/).slice(0, 2).join(' ').replace(/[^\w\s-]+$/, '');
  }
  return org;
};

const slug = (s) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

// Anchors have to be unique even if two labels are not, or the id collides and
// the map sends both settlements to whichever one the document happens to hold
// first.
function uniqueSlugs(labels) {
  const seen = new Map();
  return labels.map((label) => {
    const base = slug(label) || 'x';
    const n = (seen.get(base) ?? 0) + 1;
    seen.set(base, n);
    return n === 1 ? base : `${base}-${n}`;
  });
}

const roleAnchors = uniqueSlugs(profile.experience.roles.map((role) => orgOf(role.title)));
// One axis for every post, so the bars can be compared by eye. Null when the
// dates cannot be read, in which case the posts render without bars.
const timeline = layTimeline(profile.experience.roles);
const postSymbols = assignSymbols(profile.experience.roles.map((r) => orgOf(r.title)));
const totalStars = repos.reduce((n, r) => n + r.stargazers_count, 0);
const languages = {};
for (const r of repos) if (r.language) languages[r.language] = (languages[r.language] ?? 0) + 1;
const topLanguage = Object.entries(languages).sort((a, b) => b[1] - a[1])[0]?.[0] ?? '–';

// Measured across the whole survey rather than read off the first entry. The
// array used to open with the most recently pushed repo, so repos[0] was the
// same number; profile.github.featured now seats a few holdings at the head of
// it by hand, and a ledger row reading the top of a hand-ordered list would
// report a decision as though it were a measurement.
const lastPush = repos.reduce(
  (latest, r) => (r.pushed_at && (!latest || r.pushed_at > latest) ? r.pushed_at : latest),
  null,
);

const projectLedger = [
  ['followers', String(github.profile?.followers ?? '–')],
  ['public repos', String(repos.length)],
  ['total stars', totalStars.toLocaleString('en-IN')],
  ['top language', topLanguage],
  ['last push', ago(lastPush)],
];

const base = import.meta.env.BASE_URL; // '/' or '/repo-name/'

// Every absolute address this page publishes is built from these two, and the
// two are built from what the config was actually deployed with. They were
// typed literals once, which is fine on the day it is written and wrong the
// first time SITE_URL or SITE_BASE is set: a project-page deploy would have
// gone out with a canonical, an og:url and a schema url all pointing at the
// user page it is not. A canonical that names another site is not a small
// error, it is an instruction to index the other site instead.
const home = new URL(base, Astro.site).href;
const abs = (p) => new URL(p, home).href;

// Which holdings have a page of their own. A repo appears here because prose
// was written for it in charters.js, and the province picks that up the same
// way it picks up a description: it asks, rather than keeping its own copy.
const charterOf = new Map(charters.map((c) => [c.repo, c.slug]));
const registerHref = `${base}projects/`;
const plates = (photos.photos ?? []).map((p) => ({
  ...p,
  src: `${base}photos/${p.variants[p.variants.length - 1].name}`,
  srcset: p.variants.map((v) => `${base}photos/${v.name} ${v.width}w`).join(', '),
}));
const galleryLedger = [
  ['plates', String(plates.length)],
  ['portrait', String(plates.filter((p) => p.orientation === 'portrait').length)],
  ['landscape', String(plates.filter((p) => p.orientation !== 'portrait').length)],
  ...(profile.gallery.ledgerExtra ?? []),
];

// The order the folios are bound in, which is what the phone's territory list
// is: the table of contents for a document that has no map on it. Kept in step
// with the section order below and with 404.astro's list of provinces.
const nav = [
  ['#experience', profile.experience],
  ['#projects', profile.projects],
  ['#gallery', profile.gallery],
  ['#about', profile.about],
  ['#contact', profile.contact],
];

// A contact row with no href is not finished. Skip it rather than publish a
// dead link. Fill it in in profile.js and it appears on the next build.
const contactLinks = profile.contact.links.filter(([, text, href]) => href && text);

// Keep the "best channel" row honest: it names the first channel that is
// actually filled in, rather than promising email before there is an address.
const contactLedger = profile.contact.ledger.map(([term, value]) =>
  term === 'best channel'
    ? [term, contactLinks[0]?.[0].toLowerCase() ?? 'none listed']
    : [term, value],
);

// The writ earns a road of its own in Phoededia. It is kept out of contactLinks
// rather than pushed onto it, because that array also feeds `sameAs` in the
// schema below, and a PDF is a document, not a profile of the person.
//
// Every other road here reads as an address someone could copy off a printed
// page, so this one does too: the short /resume route rather than the filename.
const contactRows = resume.published
  ? [
      ...contactLinks,
      [
        profile.resume.contactLabel,
        `${Astro.site.host}${resume.shortHref.replace(/\/$/, '')}`,
        resume.shortHref,
      ],
    ]
  : contactLinks;

const plateAnchors = uniqueSlugs(plates.map((p) => p.caption ?? p.alt ?? ''));

// Every province surveyed from the data it is actually about, in one pass so
// that names near a border clear their neighbours across it. Recomputed on
// every build against the map's own border paths.
const survey = surveyRealm([
  {
    href: '#projects',
    items: repos.map((r) => ({
      label: r.name,
      href: `#holding-${r.name.toLowerCase()}`,
      weight: r.commits ?? 0,
    })),
  },
  {
    href: '#experience',
    // Most recent first in the list, so weight counts down from the top.
    items: profile.experience.roles.map((role, i) => ({
      label: orgOf(role.title),
      href: `#post-${roleAnchors[i]}`,
      weight: profile.experience.roles.length - i,
    })),
  },
  {
    href: '#gallery',
    items: plates.map((p, i) => ({
      label: p.caption ?? p.alt ?? `plate ${i + 1}`,
      href: `#plate-${plateAnchors[i]}`,
      weight: plates.length - i,
    })),
  },
  {
    href: '#about',
    // One seat, not a scatter. This province is a person, and a person is a
    // capital rather than a distribution.
    items: [{ label: profile.site.fullName, href: '#about', weight: 1 }],
  },
  {
    href: '#contact',
    items: contactRows.map(([label], i) => ({
      label: label.toLowerCase(),
      href: '#contact',
      weight: contactRows.length - i,
    })),
  },
]);

// What each province actually holds, for the cartouche the map raises on hover.
// Counted from the same data the folios are built from, so the map cannot
// promise twelve holdings while the Afon Empire lists nine.
const totalCommits = repos.reduce((n, r) => n + (r.commits ?? 0), 0);
const territories = {
  '#projects': { name: profile.projects.heading, holds: `${repos.length} holdings · ${totalCommits.toLocaleString('en-IN')} commits` },
  '#experience': { name: profile.experience.heading, holds: `${profile.experience.roles.length} posts held` },
  '#gallery': { name: profile.gallery.heading, holds: `${plates.length} plates kept` },
  '#about': { name: profile.about.heading, holds: 'written by a living hand' },
  '#contact': { name: profile.contact.heading, holds: `${contactRows.length} roads out` },
};

// Structured data. Inert JSON, not a script that runs.
// Built from profile.js and the live API so it cannot drift from the page:
// sameAs is whatever contact rows are actually filled in, minus the mailto.
//
// One @graph rather than four loose blocks, because the whole value of it is
// the joins. Three unrelated objects describe three strangers who happen to
// share a name; nodes with stable @ids say that the site is written by the
// person, the page is about the person, and every holding in the Afon Empire
// was authored by the same person. The ids are addresses on this site and do
// not move, which is what lets anything else ever point at them.
const personId = `${home}#person`;
const siteId = `${home}#website`;
const pageId = `${home}#webpage`;

// What the survey says he works on, rather than a list of subjects typed in by
// the person claiming them. Two sources, both measured: the languages GitHub
// reports, and the topics the repositories carry.
//
// A topic has to appear on more than one repository to count. Every topic at
// once produced ninety entries, half of them tags rather than subjects, and a
// ninety-item knowsAbout is the keyword wall in a machine-readable coat: it
// tells a crawler nothing except that the list was not curated. Appearing
// twice is the cheapest honest test of a subject someone returns to. It is
// also the feedback loop that matters here, since the way to widen this list
// is to topic a second repository on GitHub, not to write a claim into this
// file that no work on the page backs up.
const topicCount = {};
for (const r of repos) for (const t of r.topics ?? []) topicCount[t] = (topicCount[t] ?? 0) + 1;
const knowsAbout = [];
const seenSubject = new Set();
for (const subject of [
  ...repos.map((r) => r.language).filter(Boolean),
  // Topics are slugs, and a slug is not a subject. "data-pipeline" reads as an
  // identifier; "data pipeline" reads as a thing a person knows.
  ...Object.entries(topicCount)
    .filter(([, n]) => n > 1)
    .map(([t]) => t.replace(/-/g, ' ')),
]) {
  // Case-folded, or the Python the language reports and the python a topic
  // spells both land in the list.
  const key = subject.toLowerCase();
  if (seenSubject.has(key)) continue;
  seenSubject.add(key);
  knowsAbout.push(subject);
}

const person = {
  '@type': 'Person',
  '@id': personId,
  name: profile.site.fullName,
  // The handle, named as the alternate it is. The real name is the identity;
  // this is the door it answers at on three other services.
  alternateName: profile.github.username,
  url: home,
  image: abs('og-cover.png'),
  jobTitle: 'Software Engineer',
  description: profile.site.metaDescription,
  email: contactLinks.find(([, , href]) => href.startsWith('mailto:'))?.[1],
  address: { '@type': 'PostalAddress', addressLocality: 'Mumbai', addressCountry: 'IN' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Vijaybhoomi University' },
  // Languages the survey measured, and the topics the repositories themselves
  // carry. Both are read off the API rather than typed here, so the way to
  // widen this list is to topic a repository on GitHub, not to write a subject
  // into this file that no work on the page backs up.
  // Dropped entirely when the survey is empty, rather than published as an
  // empty array. A fresh clone builds against stubs, and "knowsAbout: []" is a
  // sentence that says he knows about nothing.
  ...(knowsAbout.length ? { knowsAbout } : {}),
  sameAs: contactLinks
    .map(([, , href]) => href)
    .filter((href) => !href.startsWith('mailto:')),
};

const website = {
  '@type': 'WebSite',
  '@id': siteId,
  url: home,
  name: 'The realm of Orvia',
  alternateName: profile.site.fullName,
  description: profile.site.metaDescription,
  inLanguage: 'en',
  author: { '@id': personId },
  publisher: { '@id': personId },
};

// ProfilePage rather than WebPage: this page has one subject and the subject
// is a person. mainEntity says which of the nodes below is that subject, so
// the page is not read as a page that merely mentions him.
const webpage = {
  '@type': 'ProfilePage',
  '@id': pageId,
  url: home,
  name: profile.site.metaTitle,
  description: profile.site.metaDescription,
  inLanguage: 'en',
  isPartOf: { '@id': siteId },
  about: { '@id': personId },
  mainEntity: { '@id': personId },
  primaryImageOfPage: abs('og-cover.png'),
};

// One node per holding, from the same array the province is drawn from, so the
// schema cannot list a repository the page does not show. SoftwareSourceCode
// and not SoftwareApplication: a repository is source, and only some of these
// are applications anyone installs. Claiming the wrong type is how a page
// loses rich-result eligibility, and there is nothing here to gain by it.
const holdingSchemas = repos.map((r) => {
  // A holding with a charter is addressed by the charter, and only by it. Two
  // nodes for one repository, one keyed to an anchor here and one keyed to a
  // page over there, would undo the whole point of giving these ids: the graph
  // would describe two things that happen to share a name and a source URL.
  const slug = charterOf.get(r.name);
  const id = slug ? abs(`projects/${slug}/`) : `${home}#holding-${r.name.toLowerCase()}`;
  return {
    // Source always; also an application when it is genuinely one. Both types
    // sit on this single node, under this single id, which is what keeps one
    // project one thing in the graph. See src/data/software.js.
    '@type': typeFor(r.name),
    '@id': id,
    name: r.name,
    ...applicationProps(r.name),
    url: id,
    codeRepository: r.html_url,
    ...(r.description ? { description: r.description } : {}),
    ...(r.language ? { programmingLanguage: r.language } : {}),
    ...(r.topics?.length ? { keywords: r.topics.join(', ') } : {}),
    author: { '@id': personId },
    // mainEntityOfPage, not isPartOf: a repository is not a component of this
    // page, it is a thing this page is the page about. isPartOf would have
    // been the one join in the graph that is not literally true.
    mainEntityOfPage: { '@id': pageId },
  };
});

const schema = {
  '@context': 'https://schema.org',
  '@graph': [person, website, webpage, ...holdingSchemas],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.site.metaTitle}</title>
    <meta name="description" content={profile.site.metaDescription} />
    <link rel="canonical" href={home} />
    <!-- Google Search Console ownership. Verification is revoked if this is
         removed, so it stays even though it does nothing for visitors. -->
    <meta name="google-site-verification" content="eo34pFyJFp-2ccSkvZZySrCk_kmRi1c-_oSQL6xxYNk" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- The parchment, so a mobile browser's chrome matches the page instead of
         framing it in white. -->
    <meta name="theme-color" content="#C7B991" />
    <!-- The two card titles were their own typed string once, which meant the
         page had two titles and the one nobody edits was the one every share
         showed. They read the same field as the <title> now: a pasted link and
         a search result are the same promise made in two places, and there is
         no version of this where they should disagree. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The realm of Orvia" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={profile.site.metaTitle} />
    <meta property="og:description" content={profile.site.metaDescription} />
    <meta property="og:url" content={home} />
    <meta property="og:image" content={abs('og-cover.png')} />
    <!-- Declared so the card reserves the right shape before the image lands. -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={profile.site.metaTitle} />
    <meta name="twitter:description" content={profile.site.metaDescription} />
    <meta name="twitter:image" content={abs('og-cover.png')} />
    <meta property="og:image:alt" content="A hand-drawn map of the realm of Orvia, the portfolio's five sections shown as provinces." />
    <meta name="twitter:image:alt" content="A hand-drawn map of the realm of Orvia, the portfolio's five sections shown as provinces." />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div
      class="frame"
      aria-hidden="true"
      style="position: fixed; inset: 13px; pointer-events: none; z-index: 60; border: 2px solid rgba(74,59,34,0.5); box-shadow: inset 0 0 0 5px rgba(74,59,34,0), inset 0 0 0 6px rgba(74,59,34,0.24);"
    >
      <span style="position: absolute; top: -7px; left: -7px; width: 11px; height: 11px; background: #6B5836; transform: rotate(45deg);"></span>
      <span style="position: absolute; top: -7px; right: -7px; width: 11px; height: 11px; background: #6B5836; transform: rotate(45deg);"></span>
      <span style="position: absolute; bottom: -7px; left: -7px; width: 11px; height: 11px; background: #6B5836; transform: rotate(45deg);"></span>
      <span style="position: absolute; bottom: -7px; right: -7px; width: 11px; height: 11px; background: #6B5836; transform: rotate(45deg);"></span>
    </div>

    <div class="page" style="max-width: 1040px; margin: 0 auto; padding: 0 44px;">
      <!-- ============ MAP / FIRST VIEWPORT ============ -->
      <div
        id="map"
        style="min-height: 100vh; box-sizing: border-box; width: 100vw; margin-left: calc(50% - 50vw); display: flex; flex-direction: column; justify-content: center; gap: 16px; padding: 28px 34px;"
      >
        <!-- The masthead says who this is before the map says where. The name,
             then the trade in plain words, then the one road a visitor might
             have come specifically to find. -->
        <div class="masthead" style="display: flex; justify-content: space-between; align-items: baseline; width: 100%; max-width: 1440px; margin: 0 auto; padding: 0 4px;">
          <div class="masthead-id" style="display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;">
            <h1 style={`${serif} margin: 0; font-weight: 600; font-size: 20px; letter-spacing: 3px; color: #3A2E19;`}>{profile.site.name}</h1>
            <!-- The trade, stated rather than implied. The map is an argument
                 that takes eleven screens to finish; this is the same claim in
                 six words, on the first line of the first screen. -->
            <span style={`${mono} font-size: 11px; color: #6B5836; letter-spacing: 1px;`}>{profile.site.trade}</span>
          </div>
          <!-- The writ, named on the first screen. It is a plate at the foot of
               Ponstium Empire, 65% of the way down the page and behind about
               1,800 words, which is the right place for it in a document and
               the wrong place for the one file a visitor may have come for.
               Rendered only when the PDF is really in public/, like every other
               reference to it. -->
          {resume.published && (
            <a
              class="masthead-writ"
              href={resume.href}
              download
              style={`${mono} font-size: 11px; color: #8C3B22; letter-spacing: 1px; flex-shrink: 0;`}
            >↓ {profile.resume.mastheadLink} <span style="color: #8A7752;">· {resume.size}</span></a>
          )}
        </div>

        <div class="map-stage" style="width: 100%; max-width: 1440px; margin: 0 auto;">
          <div class="map-panel" style="background: #E9DFC4; border: 3px solid #4A3B22; border-radius: 3px; padding: 12px; box-shadow: 0 2px 0 #B9A87E inset, 0 18px 44px -14px rgba(44,34,16,0.5), 0 5px 12px -3px rgba(44,34,16,0.28);">
            <div class="map-viewport">
              <OrviaMap
                inscription={inscription}
                survey={survey}
                writ={resume.published
                  ? { href: resume.href, label: profile.resume.sealLabel, size: resume.size }
                  : null}
              />
            </div>
            <!-- Pointer-tracked sheen. Purely decorative, and inert until the
                 script arms it, so it never sits as a grey film over the map
                 for someone with JavaScript disabled. -->
            <div class="map-sheen" aria-hidden="true"></div>
            <!-- Hidden until the script arms them: without it they would be
                 three buttons that do nothing. -->
            <div class="map-controls" hidden>
              <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
              <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
              <!-- Not "fit the whole realm" any more: on a phone the sheet is
                   taller than its window at rest, so this returns to the view
                   the map opened at rather than to one that shows every
                   province. On a desktop the two are the same thing. -->
              <button type="button" data-zoom="reset" aria-label="Return to the opening view">⤢</button>
            </div>
            <!-- Filled and positioned by the script from the table below. It is
                 a hover affordance for a link that already carries a full
                 aria-label, so it stays out of the accessibility tree. -->
            <div class="cartouche" aria-hidden="true" hidden>
              <span class="cartouche-name"></span>
              <span class="cartouche-holds"></span>
            </div>
          </div>
        </div>
        <script type="application/json" id="territory-data" set:html={JSON.stringify(territories)} />

        <!-- MOBILE NAV (replaces map below 700px) -->
        <nav
          class="mobile-nav"
          aria-label="Territories"
          style="width: 100%; max-width: 620px; margin: 0 auto; flex-direction: column; gap: 0; background: #E9DFC4; border: 3px solid #4A3B22; border-radius: 3px; overflow: hidden; box-shadow: 0 16px 40px -14px rgba(44,34,16,0.5), 0 4px 10px -3px rgba(44,34,16,0.26);"
        >
          {nav.map(([href, section], i) => (
            <a
              href={href}
              aria-label={`${section.heading}, ${section.navNote}`}
              style={`display: flex; flex-direction: column; gap: 3px; padding: 18px 20px; color: #3A2E19;${i < nav.length - 1 ? ' border-bottom: 1px solid #B9A87E;' : ''}`}
            >
              <span style={`${serif} font-weight: 600; font-size: 21px; letter-spacing: 2px;`}>{section.heading.toUpperCase()}</span>
              <span style={`${mono} font-size: 11px; color: #6B5836;`}>{section.navNote}</span>
            </a>
          ))}
        </nav>

        <!-- The standfirst, under the map and before the realm begins.
             The five provinces say what is here; none of them says who wrote
             it. That answer used to live in Kingdom of Dequm, 10,200px down,
             which is a long way to travel to find out whose site this is.
             Set as a caption to the map rather than as a section: no heading,
             no folio, no ledger. It is the line under the plate. -->
        <p
          class="standfirst"
          style="width: 100%; max-width: 720px; margin: 4px auto 0; padding: 0 4px; text-align: center; font-size: 15px; line-height: 1.65; color: #4A3B22;"
        >{profile.site.standfirst}</p>
      </div>

      <!-- ============ SECTION I · EXPERIENCE ============ -->
      <!-- Experience is bound first. The repositories are the larger folio and
           they used to open the realm, but a stranger cannot rank a list of
           twelve repository names on arrival, and the posts held are the part
           of this document that reads in the order it is written. The `flip`
           props move with the sections rather than staying with them: the
           ledger alternates sides down the page, and that alternation is the
           thing being preserved, not which side any one spread's ledger is on. -->
      <Lorebook
        id="experience"
        heading={profile.experience.heading}
        subtitle={profile.experience.subtitle}
        folio={profile.experience.folio}
        intro={profile.experience.intro}
        ledger={profile.experience.ledger}
        ledgerNote={profile.experience.ledgerNote}
        epigraph={profile.experience.epigraph}
        marginNote={profile.experience.marginNote}
      >
        <div class="holdings">
          {timeline && (
            <p class="tenure-legend" style={`margin: 0 0 2px; ${mono} font-size: 10px; color: #A0906A; letter-spacing: 1px;`}>
              each bar is the term, laid on one axis · {timeline.years[0].year}—{timeline.years[timeline.years.length - 1].year}
            </p>
          )}
          {profile.experience.roles.map((role, i) => (
            <Post
              role={role}
              id={`post-${roleAnchors[i]}`}
              symbol={postSymbols.get(orgOf(role.title))}
              place={placeOf(role.meta)}
              dates={role.meta.split('·')[0].trim()}
              bar={timeline ? timeline.bars[i] : null}
              years={timeline ? timeline.years : []}
            />
          ))}

          {/* The writ. Everything above, on one sheet: a plate pressed into the
              foot of the province rather than a button, because the rest of this
              page is a document and a document does not have buttons. Rendered
              only when the PDF is really in public/; see src/data/resume.js. */}
          {resume.published && (
            <a
              class="writ"
              href={resume.href}
              download
              style="display: block; margin-top: 10px; padding: 20px 24px; border: 1px solid #8C3B22; border-radius: 3px; background: rgba(140,59,34,0.045); color: #3A2E19; text-decoration: none;"
            >
              <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px;">
                <span style={`${mono} font-size: 11px; color: #8C3B22; letter-spacing: 2px;`}>{profile.resume.label}</span>
                <span style={`${mono} font-size: 10.5px; color: #8A7752; letter-spacing: 0.5px;`}>PDF · {resume.size} · revised {profile.resume.revised}</span>
              </div>
              <p style={`margin: 8px 0 0; ${serif} font-style: italic; font-size: 17px; line-height: 1.45; color: #6B5836;`}>{profile.resume.line}</p>
              <span class="writ-link" style={`display: inline-block; margin-top: 10px; ${mono} font-size: 13px; color: #8C3B22;`}>↓ {profile.resume.linkText}</span>
            </a>
          )}
        </div>

        {/* The province gives each post a paragraph. This is where the same ten
            posts are written out with responsibilities and achievements, at an
            address a search result can point at, which an anchor cannot. */}
        <p class="holdings-register" style={`margin: 30px 0 0; ${mono} font-size: 12px;`}>
          <a href={`${base}experience/`}>Read the full work history, post by post →</a>
        </p>
      </Lorebook>

      <!-- ============ SECTION II · PROJECTS ============ -->
      <Lorebook
        id="projects"
        heading={profile.projects.heading}
        subtitle={profile.projects.subtitle}
        folio={profile.projects.folio}
        intro={profile.projects.intro}
        ledger={projectLedger}
        ledgerNote={profile.projects.ledgerNote}
        epigraph={profile.projects.epigraph}
        marginNote={profile.projects.marginNote}
        flip
      >
        <div class="holdings">
          {/* Order comes out of the survey already settled: the few names in
              profile.github.featured first, then everything else by how
              recently it was pushed. sync-github.js does that sort, so
              github.json is the ledger's order and this page has no second
              opinion about it. */}
          {repos.map((r) => <Holding repo={r} ago={ago} symbol={holdingSymbols.get(r.name)} charterHref={charterOf.has(r.name) ? `${base}projects/${charterOf.get(r.name)}/` : undefined} />)}
          {repos.length === 0 && (
            <p style={`margin: 0; ${mono} font-size: 12px; color: #8A7752;`}>
              No repositories surveyed yet. Run <code>npm run sync</code> or wait for the nightly build.
            </p>
          )}
        </div>

        {/* The province is a picture of the holdings; the register is a list of
            them at an address of its own. The map cannot be linked to a
            particular holding from outside, and a list can, which is the whole
            reason the register exists. */}
        <p class="holdings-register" style={`margin: 30px 0 0; ${mono} font-size: 12px;`}>
          <a href={registerHref}>The register of holdings, every repository at one address →</a>
        </p>
        {/* The writing about these projects, which is a different question from
            the list of them: the register says what exists, the chronicles say
            why it was built that way. */}
        <p class="holdings-register" style={`margin: 10px 0 0; ${mono} font-size: 12px;`}>
          <a href={`${base}writing/`}>The chronicles, longer pieces about how this work was built →</a>
        </p>
      </Lorebook>

      <!-- ============ SECTION III · GALLERY ============ -->
      <Lorebook
        id="gallery"
        heading={profile.gallery.heading}
        subtitle={profile.gallery.subtitle}
        folio={profile.gallery.folio}
        intro={profile.gallery.intro}
        ledger={galleryLedger}
        ledgerNote={profile.gallery.ledgerNote}
        epigraph={profile.gallery.epigraph}
        marginNote={profile.gallery.marginNote}
      >
        <div style="display: flex; flex-direction: column; gap: 16px; clear: left;">
          {/* Wide plates and tall plates are packed in separate masonry blocks,
              so landscapes sit beside landscapes and portraits beside portraits.
              CSS multi-column packing means a short frame never leaves a gap
              under a tall one. column-width auto-fits the count to the width.
              Each block is ordered tallest-first (ascending width/height ratio)
              so the balance point splits the columns to near-equal height. */}
          {[
            plates.filter((p) => p.orientation !== 'portrait').sort((a, b) => a.ratio - b.ratio),
            plates.filter((p) => p.orientation === 'portrait').sort((a, b) => a.ratio - b.ratio),
          ].map((group) =>
            group.length > 0 && (
              <div style="columns: 250px; column-gap: 16px;">
                {group.map((p) => (
                  <figure class="plate" id={`plate-${plateAnchors[plates.indexOf(p)]}`}>
                    <img
                      src={p.src}
                      srcset={p.srcset}
                      sizes="(max-width: 700px) 100vw, 250px"
                      width={p.width}
                      height={p.height}
                      alt={p.alt}
                      loading="lazy"
                      decoding="async"
                      style={`display: block; width: 100%; height: auto; aspect-ratio: ${p.width} / ${p.height}; background: #D6C69C;`}
                    />
                    <figcaption>
                      <span class="plate-no" style={`${mono} font-size: 9.5px; letter-spacing: 1.4px; color: #A0906A;`}>PL. {plates.indexOf(p) + 1}</span>
                      <span style={`${mono} font-size: 10.5px; color: #8A7752;`}>{p.caption}</span>
                    </figcaption>
                  </figure>
                ))}
              </div>
            )
          )}
          {plates.length === 0 && (
            <p style={`margin: 0; ${mono} font-size: 12px; color: #8A7752;`}>
              No plates in this folio yet. Drop an image into <code>assets/photos/</code>.
            </p>
          )}
        </div>
      </Lorebook>

      <!-- ============ SECTION IV · ABOUT ============ -->
      <Lorebook
        id="about"
        heading={profile.about.heading}
        subtitle={profile.about.subtitle}
        folio={profile.about.folio}
        intro={profile.about.paragraphs[0]}
        ledger={profile.about.ledger}
        ledgerNote={profile.about.ledgerNote}
        epigraph={profile.about.epigraph}
        marginNote={profile.about.marginNote}
        flip
      >
        {/* Prose stays prose. This province is the one written by a person, so
            it gets a reader's measure and a signed foot rather than the plates
            and bars the data provinces carry. */}
        <div class="dispatch">
          {profile.about.paragraphs.slice(1).map((para) => (
            <p>{para}</p>
          ))}
          <p class="dispatch-sign" style={`${serif} font-style: italic;`}>– {profile.site.fullName}</p>
        </div>

        {/* Three paragraphs is the right length for a province and the wrong
            length for a biography. The skills, the education and the rest are
            on a page of their own. */}
        <p class="holdings-register" style={`margin: 30px 0 0; ${mono} font-size: 12px;`}>
          <a href={`${base}about/`}>About {profile.site.fullName}: skills, education and interests →</a>
        </p>
      </Lorebook>

      <!-- ============ SECTION V · CONTACT ============ -->
      <Lorebook
        id="contact"
        heading={profile.contact.heading}
        subtitle={profile.contact.subtitle}
        folio={profile.contact.folio}
        intro={profile.contact.intro}
        ledger={contactLedger}
        ledgerNote={profile.contact.ledgerNote}
        epigraph={profile.contact.epigraph}
        marginNote={profile.contact.marginNote}
      >
        <ul class="link-list roads" style="list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-direction: column; gap: 0;">
          {contactRows.map(([label, text, href]) => (
            <li>
              <a href={href} class="road">
                <span class="road-mark" aria-hidden="true">
                  <svg viewBox="0 0 40 40" width="34" height="34" fill="none" stroke="#8C3B22" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
                    <circle cx="20" cy="20" r="15" stroke="#B9A87E" stroke-width="1" stroke-dasharray="2.5 3" />
                    <path d="M12 20h16" />
                    <path d="M22 14l6 6-6 6" />
                  </svg>
                </span>
                <span class="road-label" style={`${mono} font-size: 10.5px; color: #A0906A; letter-spacing: 1.6px;`}>{label}</span>
                <span class="road-address" style={`${mono} font-size: 14px;`}>{text}</span>
              </a>
            </li>
          ))}
        </ul>
      </Lorebook>

      <!-- ============ FOOTER ============ -->
      <footer style={`text-align: center; padding: 20px 0 56px; ${mono} font-size: 11px; color: #8A7752; letter-spacing: 0.5px; line-height: 1.9;`}>
        {/* Every page on the site, named by what it holds rather than by where
            it sits. "Click here" tells a reader nothing and tells a crawler
            less; the words in a link are the only description of the thing on
            the other end that either of them gets. */}
        <nav class="footer-roads" aria-label="Pages">
          <a href={`${base}about/`}>About {profile.site.fullName}</a>
          <a href={`${base}experience/`}>The full work history</a>
          <a href={registerHref}>The register of open-source projects</a>
          <a href={`${base}writing/`}>Writing on software and machine learning</a>
          {resume.published && <a href={`${base}resume/`}>Résumé</a>}
        </nav>
        <div>{profile.site.footerLine}</div>
        {profile.site.colophon && <div style="margin-top: 6px; color: #A0906A;">{profile.site.colophon}</div>}
        <!-- The tagline, which used to sit top-right of the map. It is the
             flavour, and the flavour should not be the first thing that answers
             "who is this"; the trade beside the name does that now. It keeps a
             place here, at the end, where a line about the mapmaking belongs. -->
        {profile.site.tagline && <div style="margin-top: 6px; color: #A0906A;">{profile.site.tagline}</div>}
        <div class="return-link" style="margin-top: 6px;"><a href="#map">↑ back to the top</a></div>
      </footer>
    </div>

    <script>
      // The map, given weight. Everything below is enhancement: with the script
      // blocked the map is still a complete, navigable set of links, which is
      // why the sheen starts inert and the cartouche starts hidden.
      const stage = document.querySelector('.map-stage');
      if (stage) {
        const panel = stage.querySelector('.map-panel');
        const sheen = stage.querySelector('.map-sheen');
        const cartouche = stage.querySelector('.cartouche');
        const nameEl = cartouche.querySelector('.cartouche-name');
        const holdsEl = cartouche.querySelector('.cartouche-holds');
        const data = JSON.parse(document.getElementById('territory-data').textContent);

        const calm = matchMedia('(prefers-reduced-motion: reduce)');
        // Tilting on a touchscreen means tilting on tap, which reads as a bug.
        const fine = matchMedia('(hover: hover) and (pointer: fine)');

        let frame = 0;
        let ry = 0;
        let rx = 0;

        function draw() {
          frame = 0;
          panel.style.transform = `perspective(1800px) rotateX(${rx}deg) rotateY(${ry}deg)`;
        }

        function schedule() {
          if (!frame) frame = requestAnimationFrame(draw);
        }

        stage.addEventListener('pointermove', (e) => {
          if (calm.matches || !fine.matches) return;
          // Once the map is zoomed it is being read, not admired. Tilting the
          // sheet under someone who is panning it is just motion sickness.
          if (scale > 1.02) return;
          const r = stage.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top) / r.height;
          // Deliberately small. Enough to feel like a sheet of paper catching
          // the light, not enough to turn the survey into a carousel.
          ry = (px - 0.5) * 2.6;
          rx = (0.5 - py) * 1.9;
          sheen.style.setProperty('--mx', `${px * 100}%`);
          sheen.style.setProperty('--my', `${py * 100}%`);
          stage.classList.add('is-live');
          schedule();
        });

        stage.addEventListener('pointerleave', () => {
          ry = 0;
          rx = 0;
          stage.classList.remove('is-live');
          schedule();
        });

        function openCartouche(link) {
          const t = data[link.getAttribute('href')];
          if (!t) return;
          nameEl.textContent = t.name;
          holdsEl.textContent = t.holds;
          cartouche.hidden = false;
          const lr = link.getBoundingClientRect();
          const pr = panel.getBoundingClientRect();
          const w = cartouche.offsetWidth;
          const h = cartouche.offsetHeight;
          let x = lr.left - pr.left + lr.width / 2 - w / 2;
          // Above the province by default; below it when there is no room.
          let y = lr.top - pr.top - h - 12;
          if (y < 6) y = lr.bottom - pr.top + 12;
          x = Math.max(6, Math.min(x, pr.width - w - 6));
          cartouche.style.transform = `translate(${x}px, ${y}px)`;
          cartouche.classList.add('is-open');
        }

        function closeCartouche() {
          cartouche.classList.remove('is-open');
        }

        // Delegated rather than bound per province. pointerenter/leave on an
        // SVG <a> is unreliable across browsers, and the provinces are made of
        // many child paths. The bubbling pair plus a relatedTarget check is
        // the version that actually fires, and it does not flicker when the
        // pointer crosses between paths inside the same province.
        const linkOf = (node) => (node && node.closest ? node.closest('.region-link') : null);

        stage.addEventListener('pointerover', (e) => {
          const link = linkOf(e.target);
          if (link && linkOf(e.relatedTarget) !== link) openCartouche(link);
        });

        stage.addEventListener('pointerout', (e) => {
          const link = linkOf(e.target);
          if (link && linkOf(e.relatedTarget) !== link) closeCartouche();
        });

        stage.addEventListener('focusin', (e) => {
          const link = linkOf(e.target);
          if (link) openCartouche(link);
        });

        stage.addEventListener('focusout', (e) => {
          if (linkOf(e.target)) closeCartouche();
        });

        // Return it to hidden once it has faded, so it is never a stray
        // transparent box sitting over the provinces.
        cartouche.addEventListener('transitionend', () => {
          if (!cartouche.classList.contains('is-open')) cartouche.hidden = true;
        });

        // ── The atlas ────────────────────────────────────────────────────────
        // Zoom and pan, with one hard rule: the page's own scrolling is never
        // taken away. A plain wheel scrolls the page as it always did. Only a
        // deliberate zoom gesture zooms -- ctrl+wheel, which is also exactly
        // what a trackpad pinch sends, so pinching works without special-casing
        // it. Everything else is drag, buttons and double-click.
        const viewport = stage.querySelector('.map-viewport');
        const controls = stage.querySelector('.map-controls');
        const svg = viewport.querySelector('svg');

        const MAX = 5;
        // Past this, the villages are given their names.
        const DETAIL = 1.8;

        let scale = 1;
        let tx = 0;
        let ty = 0;

        controls.hidden = false;

        // The sheet's laid-out size, before any of our own transform. Read off
        // the computed style rather than a bounding rect because a transform
        // does not change computed width and height, so this stays true at any
        // scale and never has to be unwound.
        //
        // On a desktop the sheet is laid out to the panel's width and the
        // viewport is exactly as tall as the sheet, so this returns the
        // viewport's own size and every number below collapses to the one it
        // was before. On a phone the stylesheet gives the sheet the window's
        // height instead, which makes it wider than the window, and that
        // difference is the whole of what panning and the fit scale read.
        function sheet() {
          const cs = getComputedStyle(svg);
          return { w: parseFloat(cs.width) || 1, h: parseFloat(cs.height) || 1 };
        }

        // The floor for zooming out: the smallest scale at which the sheet
        // still covers its window in at least one direction. Below this the
        // sheet is smaller than the frame around it and the frame shows empty
        // table down two sides, which reads as a bug rather than as a map.
        //
        // Both axes are 1 on a desktop, so this is 1 and every rule below is
        // the one that was already there. On a phone the sheet is laid out to
        // the window's height, so the height ratio is 1 and the width ratio is
        // about a third. Taking the larger keeps the floor at 1 and the sheet
        // always taller than the window it is read through. Never above 1: the
        // sheet is drawn at its own size, and stretching it further is a zoom.
        function coverScale() {
          const s = sheet();
          return Math.min(Math.max(viewport.clientWidth / s.w, viewport.clientHeight / s.h), 1);
        }

        // Put the middle of the sheet in the middle of the window. clamp() runs
        // straight after and pulls it back to an edge in whichever axis the
        // sheet is smaller than its window, so this is safe at any scale.
        function centre() {
          const s = sheet();
          tx = (viewport.clientWidth - s.w * scale) / 2;
          ty = (viewport.clientHeight - s.h * scale) / 2;
        }

        function clamp() {
          const vw = viewport.clientWidth;
          const vh = viewport.clientHeight;
          const s = sheet();
          const w = s.w * scale;
          const h = s.h * scale;
          // Wider than its window: hold it against the window's edges, so the
          // sheet is never dragged off its own table. Narrower: centre it,
          // rather than pin it to a corner with a gap down one side.
          //
          // The centred case is rounded and the panning case is not, on
          // purpose. At rest the sheet sits still and a sub-pixel offset only
          // costs it crisp text. The desktop layout lands a tenth of a pixel
          // off exact, which is where that used to be a hard zero. While a hand
          // is on it the offset changes every frame, and rounding there would
          // trade blur for a drag that moves in steps.
          // The pixel of tolerance matters: the desktop sheet lays out a fifth
          // of a pixel wider than its window, which is not an overflow anyone
          // can pan and would otherwise keep the sheet permanently a tenth of a
          // pixel off true. Same tolerance overflows() uses, for the same reason.
          tx = w > vw + 1 ? Math.min(0, Math.max(vw - w, tx)) : Math.round((vw - w) / 2);
          ty = h > vh + 1 ? Math.min(0, Math.max(vh - h, ty)) : Math.round((vh - h) / 2);
        }

        function apply() {
          const min = coverScale();
          scale = Math.min(MAX, Math.max(min, scale));
          clamp();
          svg.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
          stage.classList.toggle('is-zoomed', scale > min * 1.02);
          stage.classList.toggle('is-detailed', scale >= DETAIL);
          controls.querySelector('[data-zoom="out"]').disabled = scale <= min + 0.01;
          controls.querySelector('[data-zoom="in"]').disabled = scale >= MAX - 0.01;
        }

        // Zoom about a point so the map grows out from under the pointer rather
        // than from the corner.
        function zoomAt(factor, clientX, clientY) {
          const r = viewport.getBoundingClientRect();
          const px = clientX - r.left;
          const py = clientY - r.top;
          const next = Math.min(MAX, Math.max(coverScale(), scale * factor));
          if (next === scale) return;
          tx = px - ((px - tx) / scale) * next;
          ty = py - ((py - ty) / scale) * next;
          scale = next;
          apply();
        }

        function zoomCentre(factor) {
          const r = viewport.getBoundingClientRect();
          zoomAt(factor, r.left + r.width / 2, r.top + r.height / 2);
        }

        controls.addEventListener('click', (e) => {
          const button = e.target.closest('button');
          if (!button) return;
          const kind = button.dataset.zoom;
          if (kind === 'in') zoomCentre(1.5);
          else if (kind === 'out') zoomCentre(1 / 1.5);
          else {
            // Back to the view the map opened at. On a desktop that is scale 1
            // with the whole realm in the window, exactly as before; on a phone
            // it is the sheet at its own size, centred, which is where it
            // started. Centred rather than reset to zero, or a phone would be
            // sent back to the sea off the western coast instead of the realm.
            scale = coverScale();
            centre();
            apply();
          }
        });

        viewport.addEventListener(
          'wheel',
          (e) => {
            // A bare wheel belongs to the page. Only a pinch or ctrl+wheel is a
            // zoom, and only then is the default prevented.
            if (!e.ctrlKey) return;
            e.preventDefault();
            zoomAt(e.deltaY < 0 ? 1.12 : 1 / 1.12, e.clientX, e.clientY);
          },
          { passive: false },
        );

        viewport.addEventListener('dblclick', (e) => {
          zoomAt(scale >= MAX - 0.01 ? coverScale() / scale : 1.8, e.clientX, e.clientY);
        });

        // Drag to pan. A drag that moves more than a few pixels swallows the
        // click that follows, so panning across a province never navigates.
        let dragging = false;
        let moved = false;
        let lastX = 0;
        let lastY = 0;

        // Whether the sheet is currently bigger than its window, in either
        // axis. This replaces the old `scale > 1.02` test, which assumed the
        // two were the same size at rest: true on a desktop, false on a phone,
        // where the sheet overflows its window at the scale it opens at.
        function overflows() {
          const s = sheet();
          return (
            s.w * scale > viewport.clientWidth + 1 || s.h * scale > viewport.clientHeight + 1
          );
        }

        // Two fingers scale the sheet. A trackpad pinch already arrives as
        // ctrl+wheel and is handled above; this is the touchscreen's version of
        // the same gesture. Without it a phone can see the map but never lean
        // into it, which is most of what the map is for.
        const pointers = new Map();
        let pinchGap = 0;

        const pair = () => [...pointers.values()];
        const gapOf = ([a, b]) => Math.hypot(a.x - b.x, a.y - b.y);
        const midOf = ([a, b]) => ({ x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 });

        viewport.addEventListener('pointerdown', (e) => {
          pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

          if (pointers.size === 2) {
            // A second finger turns a drag into a pinch. Drop the drag rather
            // than run both, or the sheet lurches as it scales.
            dragging = false;
            moved = true;
            pinchGap = gapOf(pair());
            return;
          }

          if (e.button !== 0 || pointers.size > 2 || !overflows()) return;
          dragging = true;
          moved = false;
          lastX = e.clientX;
          lastY = e.clientY;
          viewport.setPointerCapture(e.pointerId);
        });

        viewport.addEventListener('pointermove', (e) => {
          if (pointers.has(e.pointerId)) {
            pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
          }

          if (pointers.size === 2) {
            const p = pair();
            const gap = gapOf(p);
            if (pinchGap > 0 && gap > 0) {
              const m = midOf(p);
              zoomAt(gap / pinchGap, m.x, m.y);
            }
            pinchGap = gap;
            return;
          }

          if (!dragging) return;
          const dx = e.clientX - lastX;
          const dy = e.clientY - lastY;
          if (Math.abs(dx) + Math.abs(dy) > 3) moved = true;
          lastX = e.clientX;
          lastY = e.clientY;
          tx += dx;
          ty += dy;
          apply();
        });

        function endDrag(e) {
          pointers.delete(e.pointerId);
          if (pointers.size < 2) pinchGap = 0;
          if (!dragging) return;
          dragging = false;
          if (viewport.hasPointerCapture?.(e.pointerId)) {
            viewport.releasePointerCapture(e.pointerId);
          }
        }

        viewport.addEventListener('pointerup', endDrag);
        viewport.addEventListener('pointercancel', endDrag);

        // touch-action: pan-y hands vertical scrolling back to the browser,
        // which is the whole point. One finger down the screen belongs to the
        // page, exactly as a bare wheel does. Two fingers do not: left alone
        // they would scroll the page out from under a pinch, so a multi-touch
        // move is claimed outright.
        viewport.addEventListener(
          'touchmove',
          (e) => {
            if (e.touches.length > 1) e.preventDefault();
          },
          { passive: false },
        );

        viewport.addEventListener(
          'click',
          (e) => {
            if (moved) {
              e.preventDefault();
              e.stopPropagation();
              moved = false;
            }
          },
          true,
        );

        // Re-clamp when the panel changes size, or a zoomed map can be left
        // showing a strip of empty table down one edge. A phone rotating also
        // changes what "fit the whole realm" means, which apply() recomputes.
        addEventListener('resize', apply);

        // Open on the middle of the sheet rather than its left edge. On a
        // desktop the sheet fits its window and this is already where it sits,
        // so nothing moves. On a phone it is the difference between opening on
        // the realm and opening on the sea to the west of it.
        centre();

        // Arrival is not a movement. The transition on .map-viewport svg exists
        // so that zooming eases; letting it run on the first placement would
        // drag the sheet a third of its own width across the window while the
        // ink is still settling onto it. Placed with the transition off, then
        // handed back for every zoom and pan after this one.
        svg.style.transition = 'none';
        apply();
        svg.getBoundingClientRect();
        svg.style.transition = '';
      }
    </script>
  </body>
</html>
