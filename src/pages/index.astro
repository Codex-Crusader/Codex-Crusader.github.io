---
import '../styles/global.css';
import OrviaMap from '../components/OrviaMap.astro';
import Lorebook from '../components/Lorebook.astro';
import Holding from '../components/Holding.astro';
import { assignSymbols } from '../data/holdings.js';
import { surveyRealm } from '../data/settlements.js';
import Post from '../components/Post.astro';
import { layTimeline, placeOf } from '../data/tenure.js';
import profile from '../data/profile.js';
import resume from '../data/resume.js';
import github from '../data/github.json';
import photos from '../data/photos.json';

// The workflow passes github.run_number in. Locally it falls back to 0.
const runNumber = import.meta.env.PUBLIC_RUN_NUMBER ?? '0';
const inscription = profile.site.mapInscription.replace('{run}', runNumber);

const mono = "font-family: 'JetBrains Mono', monospace;";
const serif = "font-family: 'Cormorant Garamond', serif;";

function ago(iso) {
  if (!iso) return 'unknown';
  const days = Math.floor((Date.now() - new Date(iso)) / 86400000);
  if (days <= 0) return 'today';
  if (days === 1) return 'yesterday';
  if (days < 30) return `${days} days ago`;
  const months = Math.round(days / 30);
  if (months < 12) return months === 1 ? '1 month ago' : `${months} months ago`;
  const years = Math.round(days / 365);
  return years === 1 ? '1 year ago' : `${years} years ago`;
}

const repos = github.repos ?? [];
// Dealt once for the whole Afon Empire rather than per holding, so every mark
// in the legend is used before any of them is used twice.
const holdingSymbols = assignSymbols(repos.map((r) => r.name));

// A role's map label is the organisation, not the job title: "Technology &
// Operations Intern, Sanjay Electrical Enterprises" is a sentence, and a
// settlement needs a name. Trailing parentheticals go too, since "Kanyathon"
// is the place and "(Mumbai Division)" is a footnote about it.
const orgOf = (title) => {
  const [role, ...rest] = title.split(',');
  const org = rest.join(',').replace(/\([^)]*\)/g, '').trim();
  // "Self-employed" is not a place, and two of these roles carry it, which put
  // the same name on the map twice. Fall back to what the work was.
  if (!org || /^self-?employed$/i.test(org)) {
    return role.trim().split(/\s+/).slice(0, 2).join(' ').replace(/[^\w\s-]+$/, '');
  }
  return org;
};

const slug = (s) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

// Anchors have to be unique even if two labels are not, or the id collides and
// the map sends both settlements to whichever one the document happens to hold
// first.
function uniqueSlugs(labels) {
  const seen = new Map();
  return labels.map((label) => {
    const base = slug(label) || 'x';
    const n = (seen.get(base) ?? 0) + 1;
    seen.set(base, n);
    return n === 1 ? base : `${base}-${n}`;
  });
}

const roleAnchors = uniqueSlugs(profile.experience.roles.map((role) => orgOf(role.title)));
// One axis for every post, so the bars can be compared by eye. Null when the
// dates cannot be read, in which case the posts render without bars.
const timeline = layTimeline(profile.experience.roles);
const postSymbols = assignSymbols(profile.experience.roles.map((r) => orgOf(r.title)));
const totalStars = repos.reduce((n, r) => n + r.stargazers_count, 0);
const languages = {};
for (const r of repos) if (r.language) languages[r.language] = (languages[r.language] ?? 0) + 1;
const topLanguage = Object.entries(languages).sort((a, b) => b[1] - a[1])[0]?.[0] ?? '—';

const projectLedger = [
  ['followers', String(github.profile?.followers ?? '—')],
  ['public repos', String(repos.length)],
  ['total stars', totalStars.toLocaleString('en-IN')],
  ['top language', topLanguage],
  ['last push', ago(repos[0]?.pushed_at)],
];

const base = import.meta.env.BASE_URL; // '/' or '/repo-name/'
const plates = (photos.photos ?? []).map((p) => ({
  ...p,
  src: `${base}photos/${p.variants[p.variants.length - 1].name}`,
  srcset: p.variants.map((v) => `${base}photos/${v.name} ${v.width}w`).join(', '),
}));
const galleryLedger = [
  ['plates', String(plates.length)],
  ['portrait', String(plates.filter((p) => p.orientation === 'portrait').length)],
  ['landscape', String(plates.filter((p) => p.orientation !== 'portrait').length)],
  ...(profile.gallery.ledgerExtra ?? []),
];

const nav = [
  ['#projects', profile.projects],
  ['#experience', profile.experience],
  ['#gallery', profile.gallery],
  ['#about', profile.about],
  ['#contact', profile.contact],
];

// A contact row with no href is not finished. Skip it rather than publish a
// dead link. Fill it in in profile.js and it appears on the next build.
const contactLinks = profile.contact.links.filter(([, text, href]) => href && text);

// Keep the "best channel" row honest: it names the first channel that is
// actually filled in, rather than promising email before there is an address.
const contactLedger = profile.contact.ledger.map(([term, value]) =>
  term === 'best channel'
    ? [term, contactLinks[0]?.[0].toLowerCase() ?? 'none listed']
    : [term, value],
);

// The writ earns a road of its own in Phoededia. It is kept out of contactLinks
// rather than pushed onto it, because that array also feeds `sameAs` in the
// schema below — and a PDF is a document, not a profile of the person.
//
// Every other road here reads as an address someone could copy off a printed
// page, so this one does too: the short /resume route rather than the filename.
const contactRows = resume.published
  ? [
      ...contactLinks,
      [
        profile.resume.contactLabel,
        `${Astro.site.host}${resume.shortHref.replace(/\/$/, '')}`,
        resume.shortHref,
      ],
    ]
  : contactLinks;

const plateAnchors = uniqueSlugs(plates.map((p) => p.caption ?? p.alt ?? ''));

// Every province surveyed from the data it is actually about, in one pass so
// that names near a border clear their neighbours across it. Recomputed on
// every build against the map's own border paths.
const survey = surveyRealm([
  {
    href: '#projects',
    items: repos.map((r) => ({
      label: r.name,
      href: `#holding-${r.name.toLowerCase()}`,
      weight: r.commits ?? 0,
    })),
  },
  {
    href: '#experience',
    // Most recent first in the list, so weight counts down from the top.
    items: profile.experience.roles.map((role, i) => ({
      label: orgOf(role.title),
      href: `#post-${roleAnchors[i]}`,
      weight: profile.experience.roles.length - i,
    })),
  },
  {
    href: '#gallery',
    items: plates.map((p, i) => ({
      label: p.caption ?? p.alt ?? `plate ${i + 1}`,
      href: `#plate-${plateAnchors[i]}`,
      weight: plates.length - i,
    })),
  },
  {
    href: '#about',
    // One seat, not a scatter. This province is a person, and a person is a
    // capital rather than a distribution.
    items: [{ label: profile.site.fullName, href: '#about', weight: 1 }],
  },
  {
    href: '#contact',
    items: contactRows.map(([label], i) => ({
      label: label.toLowerCase(),
      href: '#contact',
      weight: contactRows.length - i,
    })),
  },
]);

// What each province actually holds, for the cartouche the map raises on hover.
// Counted from the same data the folios are built from, so the map cannot
// promise twelve holdings while the Afon Empire lists nine.
const totalCommits = repos.reduce((n, r) => n + (r.commits ?? 0), 0);
const territories = {
  '#projects': { name: profile.projects.heading, holds: `${repos.length} holdings · ${totalCommits.toLocaleString('en-IN')} commits` },
  '#experience': { name: profile.experience.heading, holds: `${profile.experience.roles.length} posts held` },
  '#gallery': { name: profile.gallery.heading, holds: `${plates.length} plates kept` },
  '#about': { name: profile.about.heading, holds: 'written by a living hand' },
  '#contact': { name: profile.contact.heading, holds: `${contactRows.length} roads out` },
};

// Structured data. Inert JSON, not a script that runs.
// Built from profile.js and the live API so it cannot drift from the page:
// sameAs is whatever contact rows are actually filled in, minus the mailto.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.site.fullName,
  url: 'https://codex-crusader.github.io/',
  image: 'https://codex-crusader.github.io/og-cover.png',
  jobTitle: 'Software Engineer',
  description: profile.site.metaDescription,
  email: contactLinks.find(([, , href]) => href.startsWith('mailto:'))?.[1],
  address: { '@type': 'PostalAddress', addressLocality: 'Mumbai', addressCountry: 'IN' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Vijaybhoomi University' },
  knowsAbout: [...new Set(repos.map((r) => r.language).filter(Boolean))],
  sameAs: contactLinks
    .map(([, , href]) => href)
    .filter((href) => !href.startsWith('mailto:')),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.site.metaTitle}</title>
    <meta name="description" content={profile.site.metaDescription} />
    <link rel="canonical" href="https://codex-crusader.github.io/" />
    <!-- Google Search Console ownership. Verification is revoked if this is
         removed, so it stays even though it does nothing for visitors. -->
    <meta name="google-site-verification" content="eo34pFyJFp-2ccSkvZZySrCk_kmRi1c-_oSQL6xxYNk" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- The parchment, so a mobile browser's chrome matches the page instead of
         framing it in white. -->
    <meta name="theme-color" content="#C7B991" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The realm of Orvia" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content="Bhargavaram Krishnapur — software, open source, maps" />
    <meta property="og:description" content={profile.site.metaDescription} />
    <meta property="og:url" content="https://codex-crusader.github.io/" />
    <meta property="og:image" content="https://codex-crusader.github.io/og-cover.png" />
    <!-- Declared so the card reserves the right shape before the image lands. -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Bhargavaram Krishnapur — software, open source, maps" />
    <meta name="twitter:description" content={profile.site.metaDescription} />
    <meta name="twitter:image" content="https://codex-crusader.github.io/og-cover.png" />
    <meta property="og:image:alt" content="A hand-drawn map of the realm of Orvia, the portfolio's five sections shown as provinces." />
    <meta name="twitter:image:alt" content="A hand-drawn map of the realm of Orvia, the portfolio's five sections shown as provinces." />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div
      class="frame"
      aria-hidden="true"
      style="position: fixed; inset: 13px; pointer-events: none; z-index: 60; border: 2px solid rgba(74,59,34,0.5); box-shadow: inset 0 0 0 5px rgba(74,59,34,0), inset 0 0 0 6px rgba(74,59,34,0.24);"
    >
      <span style="position: absolute; top: -7px; left: -7px; width: 11px; height: 11px; background: #6B5836; transform: rotate(45deg);"></span>
      <span style="position: absolute; top: -7px; right: -7px; width: 11px; height: 11px; background: #6B5836; transform: rotate(45deg);"></span>
      <span style="position: absolute; bottom: -7px; left: -7px; width: 11px; height: 11px; background: #6B5836; transform: rotate(45deg);"></span>
      <span style="position: absolute; bottom: -7px; right: -7px; width: 11px; height: 11px; background: #6B5836; transform: rotate(45deg);"></span>
    </div>

    <div class="page" style="max-width: 1040px; margin: 0 auto; padding: 0 44px;">
      <!-- ============ MAP / FIRST VIEWPORT ============ -->
      <div
        id="map"
        style="min-height: 100vh; box-sizing: border-box; width: 100vw; margin-left: calc(50% - 50vw); display: flex; flex-direction: column; justify-content: center; gap: 16px; padding: 28px 34px;"
      >
        <div class="masthead" style="display: flex; justify-content: space-between; align-items: baseline; width: 100%; max-width: 1440px; margin: 0 auto; padding: 0 4px;">
          <h1 style={`${serif} margin: 0; font-weight: 600; font-size: 20px; letter-spacing: 3px; color: #3A2E19;`}>{profile.site.name}</h1>
          <span style={`${mono} font-size: 11px; color: #6B5836; letter-spacing: 1px;`}>{profile.site.tagline}</span>
        </div>

        <div class="map-stage" style="width: 100%; max-width: 1440px; margin: 0 auto;">
          <div class="map-panel" style="background: #E9DFC4; border: 3px solid #4A3B22; border-radius: 3px; padding: 12px; box-shadow: 0 2px 0 #B9A87E inset, 0 18px 44px -14px rgba(44,34,16,0.5), 0 5px 12px -3px rgba(44,34,16,0.28);">
            <div class="map-viewport">
              <OrviaMap inscription={inscription} survey={survey} />
            </div>
            <!-- Pointer-tracked sheen. Purely decorative, and inert until the
                 script arms it, so it never sits as a grey film over the map
                 for someone with JavaScript disabled. -->
            <div class="map-sheen" aria-hidden="true"></div>
            <!-- Hidden until the script arms them: without it they would be
                 three buttons that do nothing. -->
            <div class="map-controls" hidden>
              <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
              <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
              <button type="button" data-zoom="reset" aria-label="Fit the whole realm">⤢</button>
            </div>
            <!-- Filled and positioned by the script from the table below. It is
                 a hover affordance for a link that already carries a full
                 aria-label, so it stays out of the accessibility tree. -->
            <div class="cartouche" aria-hidden="true" hidden>
              <span class="cartouche-name"></span>
              <span class="cartouche-holds"></span>
            </div>
          </div>
        </div>
        <script type="application/json" id="territory-data" set:html={JSON.stringify(territories)} />

        <!-- MOBILE NAV (replaces map below 700px) -->
        <nav
          class="mobile-nav"
          aria-label="Territories"
          style="width: 100%; max-width: 620px; margin: 0 auto; flex-direction: column; gap: 0; background: #E9DFC4; border: 3px solid #4A3B22; border-radius: 3px; overflow: hidden; box-shadow: 0 16px 40px -14px rgba(44,34,16,0.5), 0 4px 10px -3px rgba(44,34,16,0.26);"
        >
          {nav.map(([href, section], i) => (
            <a
              href={href}
              aria-label={`${section.heading}, ${section.navNote}`}
              style={`display: flex; flex-direction: column; gap: 3px; padding: 18px 20px; color: #3A2E19;${i < nav.length - 1 ? ' border-bottom: 1px solid #B9A87E;' : ''}`}
            >
              <span style={`${serif} font-weight: 600; font-size: 21px; letter-spacing: 2px;`}>{section.heading.toUpperCase()}</span>
              <span style={`${mono} font-size: 11px; color: #6B5836;`}>{section.navNote}</span>
            </a>
          ))}
        </nav>
      </div>

      <!-- ============ SECTION I — PROJECTS ============ -->
      <Lorebook
        id="projects"
        heading={profile.projects.heading}
        folio={profile.projects.folio}
        intro={profile.projects.intro}
        ledger={projectLedger}
        ledgerNote={profile.projects.ledgerNote}
        epigraph={profile.projects.epigraph}
        marginNote={profile.projects.marginNote}
      >
        <div class="holdings">
          {repos.map((r) => <Holding repo={r} ago={ago} symbol={holdingSymbols.get(r.name)} />)}
          {repos.length === 0 && (
            <p style={`margin: 0; ${mono} font-size: 12px; color: #8A7752;`}>
              No repositories surveyed yet. Run <code>npm run sync</code> or wait for the nightly build.
            </p>
          )}
        </div>
      </Lorebook>

      <!-- ============ SECTION II — EXPERIENCE ============ -->
      <Lorebook
        id="experience"
        heading={profile.experience.heading}
        folio={profile.experience.folio}
        intro={profile.experience.intro}
        ledger={profile.experience.ledger}
        ledgerNote={profile.experience.ledgerNote}
        epigraph={profile.experience.epigraph}
        marginNote={profile.experience.marginNote}
        flip
      >
        <div class="holdings">
          {timeline && (
            <p class="tenure-legend" style={`margin: 0 0 2px; ${mono} font-size: 10px; color: #A0906A; letter-spacing: 1px;`}>
              each bar is the term, laid on one axis · {timeline.years[0].year}—{timeline.years[timeline.years.length - 1].year}
            </p>
          )}
          {profile.experience.roles.map((role, i) => (
            <Post
              role={role}
              id={`post-${roleAnchors[i]}`}
              symbol={postSymbols.get(orgOf(role.title))}
              place={placeOf(role.meta)}
              dates={role.meta.split('·')[0].trim()}
              bar={timeline ? timeline.bars[i] : null}
              years={timeline ? timeline.years : []}
            />
          ))}

          {/* The writ. Everything above, on one sheet — a plate pressed into the
              foot of the province rather than a button, because the rest of this
              page is a document and a document does not have buttons. Rendered
              only when the PDF is really in public/; see src/data/resume.js. */}
          {resume.published && (
            <a
              class="writ"
              href={resume.href}
              download
              style="display: block; margin-top: 10px; padding: 20px 24px; border: 1px solid #8C3B22; border-radius: 3px; background: rgba(140,59,34,0.045); color: #3A2E19; text-decoration: none;"
            >
              <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px;">
                <span style={`${mono} font-size: 11px; color: #8C3B22; letter-spacing: 2px;`}>{profile.resume.label}</span>
                <span style={`${mono} font-size: 10.5px; color: #8A7752; letter-spacing: 0.5px;`}>PDF · {resume.size} · revised {profile.resume.revised}</span>
              </div>
              <p style={`margin: 8px 0 0; ${serif} font-style: italic; font-size: 17px; line-height: 1.45; color: #6B5836;`}>{profile.resume.line}</p>
              <span class="writ-link" style={`display: inline-block; margin-top: 10px; ${mono} font-size: 13px; color: #8C3B22;`}>↓ {profile.resume.linkText}</span>
            </a>
          )}
        </div>
      </Lorebook>

      <!-- ============ SECTION III — GALLERY ============ -->
      <Lorebook
        id="gallery"
        heading={profile.gallery.heading}
        folio={profile.gallery.folio}
        intro={profile.gallery.intro}
        ledger={galleryLedger}
        ledgerNote={profile.gallery.ledgerNote}
        epigraph={profile.gallery.epigraph}
        marginNote={profile.gallery.marginNote}
      >
        <div style="display: flex; flex-direction: column; gap: 16px; clear: left;">
          {/* Wide plates and tall plates are packed in separate masonry blocks,
              so landscapes sit beside landscapes and portraits beside portraits.
              CSS multi-column packing means a short frame never leaves a gap
              under a tall one. column-width auto-fits the count to the width.
              Each block is ordered tallest-first (ascending width/height ratio)
              so the balance point splits the columns to near-equal height. */}
          {[
            plates.filter((p) => p.orientation !== 'portrait').sort((a, b) => a.ratio - b.ratio),
            plates.filter((p) => p.orientation === 'portrait').sort((a, b) => a.ratio - b.ratio),
          ].map((group) =>
            group.length > 0 && (
              <div style="columns: 250px; column-gap: 16px;">
                {group.map((p) => (
                  <figure class="plate" id={`plate-${plateAnchors[plates.indexOf(p)]}`}>
                    <img
                      src={p.src}
                      srcset={p.srcset}
                      sizes="(max-width: 700px) 100vw, 250px"
                      width={p.width}
                      height={p.height}
                      alt={p.alt}
                      loading="lazy"
                      decoding="async"
                      style={`display: block; width: 100%; height: auto; aspect-ratio: ${p.width} / ${p.height}; background: #D6C69C;`}
                    />
                    <figcaption>
                      <span class="plate-no" style={`${mono} font-size: 9.5px; letter-spacing: 1.4px; color: #A0906A;`}>PL. {plates.indexOf(p) + 1}</span>
                      <span style={`${mono} font-size: 10.5px; color: #8A7752;`}>{p.caption}</span>
                    </figcaption>
                  </figure>
                ))}
              </div>
            )
          )}
          {plates.length === 0 && (
            <p style={`margin: 0; ${mono} font-size: 12px; color: #8A7752;`}>
              No plates in this folio yet. Drop an image into <code>assets/photos/</code>.
            </p>
          )}
        </div>
      </Lorebook>

      <!-- ============ SECTION IV — ABOUT ============ -->
      <Lorebook
        id="about"
        heading={profile.about.heading}
        folio={profile.about.folio}
        intro={profile.about.paragraphs[0]}
        ledger={profile.about.ledger}
        ledgerNote={profile.about.ledgerNote}
        epigraph={profile.about.epigraph}
        marginNote={profile.about.marginNote}
        flip
      >
        {/* Prose stays prose. This province is the one written by a person, so
            it gets a reader's measure and a signed foot rather than the plates
            and bars the data provinces carry. */}
        <div class="dispatch">
          {profile.about.paragraphs.slice(1).map((para) => (
            <p>{para}</p>
          ))}
          <p class="dispatch-sign" style={`${serif} font-style: italic;`}>— {profile.site.fullName}</p>
        </div>
      </Lorebook>

      <!-- ============ SECTION V — CONTACT ============ -->
      <Lorebook
        id="contact"
        heading={profile.contact.heading}
        folio={profile.contact.folio}
        intro={profile.contact.intro}
        ledger={contactLedger}
        ledgerNote={profile.contact.ledgerNote}
        epigraph={profile.contact.epigraph}
        marginNote={profile.contact.marginNote}
      >
        <ul class="link-list roads" style="list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-direction: column; gap: 0;">
          {contactRows.map(([label, text, href]) => (
            <li>
              <a href={href} class="road">
                <span class="road-mark" aria-hidden="true">
                  <svg viewBox="0 0 40 40" width="34" height="34" fill="none" stroke="#8C3B22" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
                    <circle cx="20" cy="20" r="15" stroke="#B9A87E" stroke-width="1" stroke-dasharray="2.5 3" />
                    <path d="M12 20h16" />
                    <path d="M22 14l6 6-6 6" />
                  </svg>
                </span>
                <span class="road-label" style={`${mono} font-size: 10.5px; color: #A0906A; letter-spacing: 1.6px;`}>{label}</span>
                <span class="road-address" style={`${mono} font-size: 14px;`}>{text}</span>
              </a>
            </li>
          ))}
        </ul>
      </Lorebook>

      <!-- ============ FOOTER ============ -->
      <footer style={`text-align: center; padding: 20px 0 56px; ${mono} font-size: 11px; color: #8A7752; letter-spacing: 0.5px; line-height: 1.9;`}>
        <div>{profile.site.footerLine}</div>
        {profile.site.colophon && <div style="margin-top: 6px; color: #A0906A;">{profile.site.colophon}</div>}
        <div class="return-link" style="margin-top: 6px;"><a href="#map">↑ back to the top</a></div>
      </footer>
    </div>

    <script>
      // The map, given weight. Everything below is enhancement: with the script
      // blocked the map is still a complete, navigable set of links, which is
      // why the sheen starts inert and the cartouche starts hidden.
      const stage = document.querySelector('.map-stage');
      if (stage) {
        const panel = stage.querySelector('.map-panel');
        const sheen = stage.querySelector('.map-sheen');
        const cartouche = stage.querySelector('.cartouche');
        const nameEl = cartouche.querySelector('.cartouche-name');
        const holdsEl = cartouche.querySelector('.cartouche-holds');
        const data = JSON.parse(document.getElementById('territory-data').textContent);

        const calm = matchMedia('(prefers-reduced-motion: reduce)');
        // Tilting on a touchscreen means tilting on tap, which reads as a bug.
        const fine = matchMedia('(hover: hover) and (pointer: fine)');

        let frame = 0;
        let ry = 0;
        let rx = 0;

        function draw() {
          frame = 0;
          panel.style.transform = `perspective(1800px) rotateX(${rx}deg) rotateY(${ry}deg)`;
        }

        function schedule() {
          if (!frame) frame = requestAnimationFrame(draw);
        }

        stage.addEventListener('pointermove', (e) => {
          if (calm.matches || !fine.matches) return;
          // Once the map is zoomed it is being read, not admired. Tilting the
          // sheet under someone who is panning it is just motion sickness.
          if (scale > 1.02) return;
          const r = stage.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top) / r.height;
          // Deliberately small. Enough to feel like a sheet of paper catching
          // the light, not enough to turn the survey into a carousel.
          ry = (px - 0.5) * 2.6;
          rx = (0.5 - py) * 1.9;
          sheen.style.setProperty('--mx', `${px * 100}%`);
          sheen.style.setProperty('--my', `${py * 100}%`);
          stage.classList.add('is-live');
          schedule();
        });

        stage.addEventListener('pointerleave', () => {
          ry = 0;
          rx = 0;
          stage.classList.remove('is-live');
          schedule();
        });

        function openCartouche(link) {
          const t = data[link.getAttribute('href')];
          if (!t) return;
          nameEl.textContent = t.name;
          holdsEl.textContent = t.holds;
          cartouche.hidden = false;
          const lr = link.getBoundingClientRect();
          const pr = panel.getBoundingClientRect();
          const w = cartouche.offsetWidth;
          const h = cartouche.offsetHeight;
          let x = lr.left - pr.left + lr.width / 2 - w / 2;
          // Above the province by default; below it when there is no room.
          let y = lr.top - pr.top - h - 12;
          if (y < 6) y = lr.bottom - pr.top + 12;
          x = Math.max(6, Math.min(x, pr.width - w - 6));
          cartouche.style.transform = `translate(${x}px, ${y}px)`;
          cartouche.classList.add('is-open');
        }

        function closeCartouche() {
          cartouche.classList.remove('is-open');
        }

        // Delegated rather than bound per province. pointerenter/leave on an
        // SVG <a> is unreliable across browsers, and the provinces are made of
        // many child paths — the bubbling pair plus a relatedTarget check is
        // the version that actually fires, and it does not flicker when the
        // pointer crosses between paths inside the same province.
        const linkOf = (node) => (node && node.closest ? node.closest('.region-link') : null);

        stage.addEventListener('pointerover', (e) => {
          const link = linkOf(e.target);
          if (link && linkOf(e.relatedTarget) !== link) openCartouche(link);
        });

        stage.addEventListener('pointerout', (e) => {
          const link = linkOf(e.target);
          if (link && linkOf(e.relatedTarget) !== link) closeCartouche();
        });

        stage.addEventListener('focusin', (e) => {
          const link = linkOf(e.target);
          if (link) openCartouche(link);
        });

        stage.addEventListener('focusout', (e) => {
          if (linkOf(e.target)) closeCartouche();
        });

        // Return it to hidden once it has faded, so it is never a stray
        // transparent box sitting over the provinces.
        cartouche.addEventListener('transitionend', () => {
          if (!cartouche.classList.contains('is-open')) cartouche.hidden = true;
        });

        // ── The atlas ────────────────────────────────────────────────────────
        // Zoom and pan, with one hard rule: the page's own scrolling is never
        // taken away. A plain wheel scrolls the page as it always did. Only a
        // deliberate zoom gesture zooms -- ctrl+wheel, which is also exactly
        // what a trackpad pinch sends, so pinching works without special-casing
        // it. Everything else is drag, buttons and double-click.
        const viewport = stage.querySelector('.map-viewport');
        const controls = stage.querySelector('.map-controls');
        const svg = viewport.querySelector('svg');

        const MIN = 1;
        const MAX = 5;
        // Past this, the villages are given their names.
        const DETAIL = 1.8;

        let scale = 1;
        let tx = 0;
        let ty = 0;

        controls.hidden = false;

        function clamp() {
          // Never let the sheet be dragged off its own table.
          const w = viewport.clientWidth;
          const h = viewport.clientHeight;
          const minX = w - w * scale;
          const minY = h - h * scale;
          tx = Math.min(0, Math.max(minX, tx));
          ty = Math.min(0, Math.max(minY, ty));
          if (scale <= 1) {
            tx = 0;
            ty = 0;
          }
        }

        function apply() {
          clamp();
          svg.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
          stage.classList.toggle('is-zoomed', scale > 1.02);
          stage.classList.toggle('is-detailed', scale >= DETAIL);
          controls.querySelector('[data-zoom="out"]').disabled = scale <= MIN + 0.01;
          controls.querySelector('[data-zoom="in"]').disabled = scale >= MAX - 0.01;
        }

        // Zoom about a point so the map grows out from under the pointer rather
        // than from the corner.
        function zoomAt(factor, clientX, clientY) {
          const r = viewport.getBoundingClientRect();
          const px = clientX - r.left;
          const py = clientY - r.top;
          const next = Math.min(MAX, Math.max(MIN, scale * factor));
          if (next === scale) return;
          tx = px - ((px - tx) / scale) * next;
          ty = py - ((py - ty) / scale) * next;
          scale = next;
          apply();
        }

        function zoomCentre(factor) {
          const r = viewport.getBoundingClientRect();
          zoomAt(factor, r.left + r.width / 2, r.top + r.height / 2);
        }

        controls.addEventListener('click', (e) => {
          const button = e.target.closest('button');
          if (!button) return;
          const kind = button.dataset.zoom;
          if (kind === 'in') zoomCentre(1.5);
          else if (kind === 'out') zoomCentre(1 / 1.5);
          else {
            scale = 1;
            tx = 0;
            ty = 0;
            apply();
          }
        });

        viewport.addEventListener(
          'wheel',
          (e) => {
            // A bare wheel belongs to the page. Only a pinch or ctrl+wheel is a
            // zoom, and only then is the default prevented.
            if (!e.ctrlKey) return;
            e.preventDefault();
            zoomAt(e.deltaY < 0 ? 1.12 : 1 / 1.12, e.clientX, e.clientY);
          },
          { passive: false },
        );

        viewport.addEventListener('dblclick', (e) => {
          zoomAt(scale >= MAX - 0.01 ? 1 / (MAX / MIN) : 1.8, e.clientX, e.clientY);
        });

        // Drag to pan. A drag that moves more than a few pixels swallows the
        // click that follows, so panning across a province never navigates.
        let dragging = false;
        let moved = false;
        let lastX = 0;
        let lastY = 0;

        viewport.addEventListener('pointerdown', (e) => {
          if (e.button !== 0 || scale <= 1.02) return;
          dragging = true;
          moved = false;
          lastX = e.clientX;
          lastY = e.clientY;
          viewport.setPointerCapture(e.pointerId);
        });

        viewport.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          const dx = e.clientX - lastX;
          const dy = e.clientY - lastY;
          if (Math.abs(dx) + Math.abs(dy) > 3) moved = true;
          lastX = e.clientX;
          lastY = e.clientY;
          tx += dx;
          ty += dy;
          apply();
        });

        function endDrag(e) {
          if (!dragging) return;
          dragging = false;
          if (viewport.hasPointerCapture?.(e.pointerId)) {
            viewport.releasePointerCapture(e.pointerId);
          }
        }

        viewport.addEventListener('pointerup', endDrag);
        viewport.addEventListener('pointercancel', endDrag);

        viewport.addEventListener(
          'click',
          (e) => {
            if (moved) {
              e.preventDefault();
              e.stopPropagation();
              moved = false;
            }
          },
          true,
        );

        // Re-clamp when the panel changes size, or a zoomed map can be left
        // showing a strip of empty table down one edge.
        addEventListener('resize', apply);

        apply();
      }
    </script>
  </body>
</html>
